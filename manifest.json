{
  "manifest_version": 3,
  "name": "Sidecode — Code Editor Sidebar",
  "version": "2.0.0",
  "description": "A Monaco-powered code editor in your browser sidebar with tabs, language selection and persistent storage. Created by utkarshkumar712.",
  "author": "utkarshkumar712",
  "homepage_url": "https://github.com/UTKARSHKUMAR712/Sidecode",
  "permissions": ["sidePanel", "storage", "nativeMessaging"],
  "host_permissions": [
    "https://emkc.org/*",
    "https://godbolt.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "sandbox": {
    "pages": ["sidepanel/sandbox.html"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Toggle Sidecode"
    }
  },
  "action": {
    "default_title": "Open Sidecode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
